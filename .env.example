# WEB-APP: keine ERGO-Zugangsdaten auf Vercel hinterlegen.
# Platzhalter: durch eigene PostgreSQL-Verbindung ohne ssl*-URL-Parameter ersetzen.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/parkplatzbuchung
DATABASE_SSL=verify-full
# Nur lokale Entwicklung mit lokalem PostgreSQL: DATABASE_SSL=disable
# Optionale private CA als PEM (Zeilenumbrueche oder escaped \n):
DATABASE_SSL_CA=
DATABASE_POOL_MAX=3
# Produktion: exakte https-Origin, ohne Pfad oder abschliessenden Slash.
APP_AUTH_ORIGIN=http://localhost:3001
APP_AUTH_USERNAME=
# scrypt-Hash ueber npm run auth:hash erzeugen, niemals ein Klartextpasswort.
# Format scrypt:SALT_HEX:HASH_HEX; keine Dollarzeichen/Environment-Interpolation.
APP_AUTH_PASSWORD_HASH=

# PLANUNG: bestaetigte Freigabe Vortag 00:01 Europe/Berlin.
BOOKING_RELEASE_LEAD_DAYS=1

# SPAETERER WORKER: ausschliesslich auf separatem Worker, NICHT auf Vercel.
PARKING_URL=https://duesseldorf.ergoladesaeulen.de
PARKING_USERNAME=
PARKING_PASSWORD=
PLAYWRIGHT_HEADLESS=true
WORKER_ID=local-dry-run
WORKER_MODE=dry-run
