# Nur Vorlage. Echte Datei: /etc/parkplatzbuchung/worker.env, root:root, 0600.
# Keine ERGO- oder Web-Login-Zugangsdaten erforderlich!
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST/parkplatzbuchung
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=3
WORKER_ID=parking-worker-1
WORKER_MODE=dry-run
# Optional: tatsaechlicher Git-Commit (7-40 Hexzeichen), sonst phase-3a.
# WORKER_VERSION=
NODE_ENV=production
